# Delivery time
orders['delivery_time'] = (
    orders['order_delivered_customer_date'] - orders['order_purchase_timestamp']
).dt.days

# Delivery delay
orders['delivery_delay'] = (
    orders['order_delivered_customer_date'] - orders['order_estimated_delivery_date']
).dt.days


orders.info()


orders.head(4)


orders[['delivery_time', 'delivery_delay']].head()


orders[['delivery_time', 'delivery_delay']].describe()








orders.describe()


orders = orders[
    (orders['delivery_time'] >= 0) &
    (orders['delivery_time'] <= 60)
]
orders = orders[
    (orders['delivery_delay'] >= -60) &
    (orders['delivery_delay'] <= 60)
]


orders[["delivery_time" , "delivery_delay"]].describe()





products.describe()


zeros = (products['product_weight_g'] == 0).sum()
total = len(products)
print(zeros)
print((zeros / total) * 100)


products.loc[products['product_weight_g'] == 0, 'product_weight_g'] = np.nan

products['product_weight_g'] = products['product_weight_g'].fillna(
    products['product_weight_g'].median()
)


products["product_weight_g"].describe()








df = orders.copy()

df = df.merge(customers, on='customer_id', how='left')

df = df.merge(order_items, on='order_id', how='left')

df = df.merge(products, on='product_id', how='left')

df = df.merge(sellers, on='seller_id', how='left')

df = df.merge(payments, on='order_id', how='left')

df = df.merge(reviews, on='order_id', how='left')


df.head()


df.info()


df.isnull().sum()/df.shape[0]*100


# Drop product text features (correct column names)
df = df.drop(columns=[
    "product_name_lenght",
    "product_description_lenght",
    "product_photos_qty"
], errors='ignore')


# Fill product dimensions (very low missing %)
for col in ["product_length_cm","product_height_cm","product_width_cm"]:
    if col in df.columns:
        df[col] = df[col].fillna(df[col].median())


# Drop missing payment rows (very small % missing ~0.002%)
df = df.dropna(subset=[
    "payment_sequential",
    "payment_type",
    "payment_installments",
    "payment_value"
])


# Drop review text columns (high missing, not useful for analysis)
df = df.drop(columns=[
    'review_comment_title',
    'review_comment_message'
], errors='ignore')


df.isnull().sum()/df.shape[0]*100








df.info()
df.describe()


df.shape


df.isnull().sum().sort_values(ascending=False)





df['payment_value'].sum()


df['order_month'] = df['order_purchase_timestamp'].dt.to_period('M')

monthly_sales = df.groupby('order_month')['payment_value'].sum().reset_index()
monthly_sales['order_month'] = monthly_sales['order_month'].astype(str)

plt.figure(figsize=(10,5))
sns.lineplot(data=monthly_sales, x='order_month', y='payment_value')
plt.xticks(rotation=45)
plt.title("Monthly Revenue Trend")
plt.xlabel("Month")
plt.ylabel("Revenue")
plt.show()





